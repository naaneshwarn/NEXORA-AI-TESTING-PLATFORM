APP_NAME=NEXORA
APP_ENV=development
API_PREFIX=/api/v1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -- Authentication (backend: FastAPI on :8000) -----------------------------
# Comma-separated API keys accepted via `X-API-Key` or `Authorization: Bearer`.
# Empty by default: local development and the test suite run credential-free.
NEXORA_API_KEYS=
# Enforcement mode: auto | off | write | full
#   auto  -> "write" when keys are configured, otherwise "off"
#   off   -> never enforce (synthetic sentinels still simulate 401/403)
#   write -> mutations (POST/PUT/PATCH/DELETE) require a valid key; reads open
#   full  -> every request under the API prefix requires a valid key
# Note: `full` mode breaks the dashboard's SSE trace stream (EventSource cannot
# send headers) — `write` is the recommended production setting.
NEXORA_AUTH_MODE=auto

# -- Durable core-store persistence (backend) ------------------------------
# JSON snapshot directory for agents/runs/environments/leads/traces/reports.
# Relative paths resolve against backend/. Set empty to disable persistence.
NEXORA_STATE_DIR=.state

# -- Workflow execution (Rahul / Work Package D) ---------------------------
# Operational knobs for the workflow subsystem. Tune per deployment.
WORKFLOW_TOTAL_TIMEOUT_SECONDS=30
WORKFLOW_AGENT_TIMEOUT_SECONDS=10
WORKFLOW_DEFAULT_PASS_THRESHOLD=70
WORKFLOW_MAX_CONCURRENT_RUNS=4
# Durable directory for run-context snapshots (survives restarts).
WORKFLOW_STATE_DIR=.workflow_state

# -- Frontend (apps/web: Vite) ---------------------------------------------
# Base URL of the FastAPI backend used by the dashboard.
VITE_API_BASE_URL=http://localhost:8000
# Optional build-time API key. Prefer setting it at runtime via
# sessionStorage key `nexora_api_key` so a deployed dashboard can be
# re-keyed without a rebuild. Leave empty for anonymous local dev.
VITE_API_KEY=
